# Copy to .env and fill in. Never commit .env.

# --- required ---
GEMINI_API_KEY=

# --- LLM ---
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1
# Thinking tokens count against this budget on Gemini 3.x
LLM_MAX_OUTPUT_TOKENS=2048
# minimal | low | medium | high | empty = model default (Gemini 3.x)
LLM_THINKING_LEVEL=low
# Gemini 2.5 models only: token budget instead of a level (overrides LLM_THINKING_LEVEL)
LLM_THINKING_BUDGET=

# --- retrieval ---
RETRIEVAL_MODE=hybrid
RETRIEVE_K=8
BM25_K=8
RERANK_K=12
FINAL_K=3
MIN_RERANK_SCORE=-10.25

# --- generation eval (shipment-rag eval-gen) ---
# gemini, or ollama for a local judge (no quota; needs `ollama pull <JUDGE_MODEL>`)
JUDGE_PROVIDER=gemini
# gemini: empty = same model as GEMINI_MODEL. ollama: required, e.g. qwen2.5:7b
JUDGE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# who checks that a cited passage supports its sentence: llm (the judge model) or nli
CITATION_CHECKER=nli
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_MIN_ENTAILMENT=0.9
JUDGE_THINKING_LEVEL=medium
# max uncached LLM calls per minute during eval-gen (answers + judge)
EVAL_RPM=8

# --- vector store (leave CHROMA_HOST empty for embedded on-disk mode) ---
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_PATH=data/chroma_db
COLLECTION_NAME=supply_chain

# --- API security ---
# Comma-separated keys the API accepts in the X-API-Key header. Empty = no auth (dev only).
API_KEYS=
# Key the UI sends to the API (must be one of API_KEYS when auth is on)
API_KEY=
CORS_ORIGINS=

# --- UI demo login (replace with SSO before real users) ---
UI_USERNAME=demo
UI_PASSWORD=demo123
SHOW_DEMO_HINT=true

# --- runtime ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# Answer exact shipment questions from a read-only table, without calling the LLM
STRUCTURED_QUERIES=true

# Follow-up questions: rewrite them into standalone questions before searching.
# off = questions used as written. ollama = local model, no quota. gemini = one extra call each.
REWRITE_PROVIDER=off
# REWRITE_MODEL=qwen2.5:7b
# Also rewrite questions with no history into document wording (one more LLM call per question).
REWRITE_EVERY_QUESTION=false
