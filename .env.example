# Copy to .env and fill in. Never commit .env.

# --- required ---
GEMINI_API_KEY=

# --- LLM ---
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=512

# --- retrieval ---
RETRIEVE_K=8
FINAL_K=3
MIN_RERANK_SCORE=-6.0

# --- vector store (leave CHROMA_HOST empty for embedded on-disk mode) ---
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_PATH=data/chroma_db
COLLECTION_NAME=supply_chain

# --- API security ---
# Comma-separated keys the API accepts in the X-API-Key header. Empty = no auth (dev only).
API_KEYS=
# Key the UI sends to the API (must be one of API_KEYS when auth is on)
API_KEY=
CORS_ORIGINS=

# --- UI demo login (replace with SSO before real users) ---
UI_USERNAME=demo
UI_PASSWORD=demo123
SHOW_DEMO_HINT=true

# --- runtime ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
